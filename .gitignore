# data lake at the repo root — regenerable, never committed.
# The leading slash matters: a bare `data/` also matches regime_lab/data/,
# which silently kept the point-in-time core out of the first push.
/data/
*.parquet
*.csv
!docs/**/*.csv

# reference PDFs (copyrighted)
docs/references/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# secrets
.env
.env.*
!.env.example

# os
.DS_Store

# Shiller ie_data.xls and any other spreadsheet: fetched over HTTP by
# scripts/replicate_shu2024.py, which reads the URL and never this file. Verified
# live 2026-09-22 (HTTP 200), so the local copy is a convenience and not the only
# one. History is not rewritten: a force-push over a published tag costs more than
# 1.6 MB of blob, which is the same reasoning applied to the anonymisation.
*.xls

# Measurement scripts and inputs of the five research plans and of the A4
# counter-expertises, rescued on 2026-09-22 from a temporary scratchpad that a
# reboot would have erased. Kept on disk but not published: almost every file
# carries absolute paths, and the Rentec ones point into a private repository.
# Sanitising and committing them is an open task (pilotage/feuille_de_route/TACHES.md).
/pilotage/mesures_brutes/
